# Connexion Supabase (clé anon / publishable uniquement — jamais la service_role).
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=VOTRE_CLE_ANON_PUBLISHABLE

# Authentification email + mot de passe. "false" (ou absent) = accès direct, écran de
# connexion prêt mais non appliqué. "true" = connexion exigée (après avoir créé des
# utilisateurs dans Supabase → Auth, et restreint les policies RLS aux authentifiés).
VITE_AUTH_ENABLED=false
